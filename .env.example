# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# --- LLM (OpenAI-compatible endpoint) ---
# Default provider is OpenRouter with a free-tier model (rate-limited, no
# payment required). Swap LLM_BASE_URL/LLM_MODEL to point at Together AI,
# Fireworks, DeepInfra, OpenAI, or any other OpenAI-compatible host instead.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.2:free

# --- Redis / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Tunables ---
MAX_FILES_PER_PR=40
MAX_FILE_BYTES=200000
SKIP_BOT_AUTHORS=true
